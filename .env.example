# ==========================================
# PayAgent OS — Configuration Template
# ==========================================

# Server Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# PayPal Developer Credentials (From developer.paypal.com -> Apps & Credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Autonomous Policy Guardrail Defaults
DEFAULT_MAX_PER_TRANSACTION=50.00
DEFAULT_DAILY_BUDGET=250.00
CURRENCY=USD

# AI / LLM Configuration (Optional: for enhanced reasoning & classification)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_BASE_URL=http://localhost:11434
